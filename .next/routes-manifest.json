    {
      "page": "/dashboard/analise-parcelas",
      "regex": "^/dashboard/analise\\-parcelas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/analise\\-parcelas(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
