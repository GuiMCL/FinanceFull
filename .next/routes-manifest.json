    },
    {
      "page": "/insights",
      "regex": "^/insights(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/insights(?:/)?$"
    },
    {
      "page": "/lancamentos",
      "regex": "^/lancamentos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lancamentos(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/manifest.json",
      "regex": "^/manifest\\.json(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.json(?:/)?$"
    },
    {
      "page": "/orcamentos",
      "regex": "^/orcamentos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/orcamentos(?:/)?$"
    },
    {
      "page": "/pagadores",
      "regex": "^/pagadores(?:/)?$",
