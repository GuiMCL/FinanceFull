    },
    {
      "page": "/categorias",
      "regex": "^/categorias(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/categorias(?:/)?$"
    },
    {
      "page": "/categorias/historico",
      "regex": "^/categorias/historico(?:/)?$",
